# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ── Dependencies ────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Environment & Secrets ───────────────────────
# Never commit credentials or secrets to public git!
.env*
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*
!.env.example

# SSL & Security Credentials
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
id_rsa
id_rsa.pub

# ── Next.js, Turbopack & Build Artifacts ────────
/.next/
/out/
/build
/dist/
/.turbo/
*.tsbuildinfo
next-env.d.ts

# ── Databases & Local Storage ───────────────────
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-journal
prisma/*.db
prisma/*.db-journal
dev.db

# ── Testing & Coverage ──────────────────────────
/coverage
/.nyc_output

# ── Logs & Debugging ────────────────────────────
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Vercel ──────────────────────────────────────
.vercel

# ── Operating System ────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ── IDEs & Editors ──────────────────────────────
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~
